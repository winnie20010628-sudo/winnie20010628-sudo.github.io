# WhatsApp 通知（CallMeBot：免費個人用途）
# 1. 將 +34 644 21 99 47 存到通訊錄
# 2. 傳送「I allow callmebot to send me messages」取得 API key
# 詳情：https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_PHONE=852xxxxxxxx
WHATSAPP_API_KEY=your_callmebot_api_key

# 可選：改用 Twilio WhatsApp（留空則用 CallMeBot）
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+852xxxxxxxx

# 監控間隔（秒）
CHECK_INTERVAL_SECONDS=60

# Web 介面
HOST=0.0.0.0
PORT=8000
